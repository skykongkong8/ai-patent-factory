    {
      "id": "claim_8456c42952684f42804431aaac39e907",
      "statement": "The run kernel persists authoritative run state and provenance in SQLite: runs carry state and version; immutable artifact revisions, current pointers, dependency edges, transition events, idempotency records, gate envelopes and decisions, and export registrations are represented by dedicated tables with foreign-key relationships.",
      "evidence": [
        {
          "resource": "repo://src/patent_factory/database.py#L27-L44",
          "version": "repo-lines-v1:sha256:a4423ddd15e2fafb654069ffd47bc8928ce0ed08ab5ddbe02c04989f3440e3e0:"
        }
      ]
    },
    {
      "id": "claim_ef364468791347ed89bf4a5b4d26bff1",
      "statement": "`start_run()` accepts a run only after the supplied profile matches the authoritative profile database and is profile-ready, then creates or replays the run, records profile-pending and profile-ready transitions, and publishes a hash-bound profile-context artifact while moving to research-ready.",
